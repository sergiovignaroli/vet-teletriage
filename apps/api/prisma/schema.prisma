// Schema de base de datos — Plataforma de Teletriage Veterinario
// Cada modelo referencia, en comentario, la sección del contrato o del
// documento de decisiones de diseño de donde sale la regla que codifica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Veterinario
// ---------------------------------------------------------------------------

model Veterinario {
  id                String   @id @default(uuid())
  nombre            String
  apellido          String
  email             String   @unique
  telefono          String?
  passwordHash      String
  // Se incrementa para invalidar TODOS los JWT emitidos antes de este valor
  // (logout forzado / password comprometida) sin necesidad de una blacklist
  // de tokens — ver jwt.strategy.ts.
  tokenVersion      Int      @default(0)

  // Habilitación (Sección 2 del contrato)
  dniONumero        String
  matriculaNumero   String
  matriculaColegio  String
  matriculaVenceEl  DateTime
  seguroAseguradora String
  seguroPoliza      String
  seguroVenceEl     DateTime

  // Estado operativo
  estado            EstadoVeterinario @default(PENDIENTE_VERIFICACION)
  disponible        Boolean           @default(false)

  // Onboarding de producto (no confundir con habilitación de la Sección 2):
  // recorrido guiado de 3 pantallas la primera vez que entra a la app.
  // false hasta que lo termine o lo salte — de ahí en más no se le vuelve
  // a mostrar.
  onboardingCompletado Boolean        @default(false)

  // Ubicación para matching por proximidad (Sección 11)
  latitud           Float?
  longitud          Float?

  // Precio (decisión de Sergio, 2026-09-29): el veterinario ya no declara
  // un honorario libre — ajusta, en %, el honorarioBase que calcula la
  // plataforma por franja horaria + urgencia (ver honorarioBaseDe() en
  // packages/types). Acotado a [MARGEN_PORCENTAJE_MIN, MARGEN_PORCENTAJE_MAX]
  // en VeterinariosService.ajustarMargen — nunca confiar en un valor que
  // llegue ya fuera de rango.
  margenPorcentaje  Int      @default(0)

  // Cobro (Sección 5 del contrato)
  medioDeCobro      MedioDeCobroVeterinario @default(MERCADO_PAGO)
  // Split de Pagos 1:1 (doc de proveedores) — credenciales OAuth propias del
  // veterinario como vendedor de Mercado Pago, nunca las de la plataforma.
  mercadoPagoOAuthId       String?   // user_id del vendedor en Mercado Pago
  mercadoPagoAccessToken   String?
  mercadoPagoRefreshToken  String?
  mercadoPagoTokenVenceEl  DateTime?
  payoneerEmail      String?

  // Verificación de identidad (Sección 6)
  verificacionesIdentidad VerificacionIdentidad[]

  casos             Caso[]
  calificaciones    Calificacion[]
  disputasIdentidad DisputaIdentidad[]
  puntos            PuntoPremio[]

  creadoEl          DateTime @default(now())
  actualizadoEl     DateTime @updatedAt

  @@index([disponible, latitud, longitud])
}

enum EstadoVeterinario {
  PENDIENTE_VERIFICACION
  HABILITADO
  SUSPENDIDO_MATRICULA_VENCIDA // suspensión automática, no disciplinaria (Sección 2)
  SUSPENDIDO_SEGURO_VENCIDO    // ídem
  SUSPENDIDO_DISPUTA_IDENTIDAD // cautelar, Sección 10
  SUSPENDIDO_INCUMPLIMIENTO    // Sección 15
  DESVINCULADO
}

enum MedioDeCobroVeterinario {
  MERCADO_PAGO
  PAYONEER
}

// ---------------------------------------------------------------------------
// Cliente
// ---------------------------------------------------------------------------

model Cliente {
  id            String   @id @default(uuid())
  // Login sin contraseña vía OTP por WhatsApp (doc de proveedores): el
  // teléfono es el identificador primario, no el email. nombre/email se
  // completan en el perfil después del primer login, no son requisito de
  // alta — pedirlos antes solo agrega fricción a un flujo de emergencia.
  nombre        String?
  email         String?  @unique
  telefono      String   @unique
  paisDePago    String?  // determina si se le ofrece Mercado Pago, PayPal o tarjeta internacional

  otpCodeHash   String?
  otpExpiraEl   DateTime?
  otpIntentos   Int      @default(0)
  tokenVersion  Int      @default(0) // ver comentario en Veterinario.tokenVersion

  // Onboarding de producto — ver comentario en Veterinario.onboardingCompletado
  onboardingCompletado Boolean @default(false)

  casos         Caso[]
  creadoEl      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Admin — staff de la plataforma, NO de autoservicio (no hay endpoint público
// de alta). El primer admin se crea con la clave de bootstrap (ver
// admin-key.guard.ts / AuthService.registrarAdmin); de ahí en más entra con
// email + contraseña como cualquier otro rol, y cada decisión de staff sobre
// una disputa queda firmada con SU id, no con una clave compartida.
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  creadoEl     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Caso (una sesión de teletriage, de punta a punta)
// ---------------------------------------------------------------------------

model Caso {
  id              String       @id @default(uuid())
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  clienteId       String
  veterinario     Veterinario? @relation(fields: [veterinarioId], references: [id])
  veterinarioId   String?

  estado          EstadoCaso   @default(INTAKE)

  // Intake — dos capas (Sección 9 del contrato)
  intake          IntakeFormulario?

  // Franja horaria y montos (Sección 4 del contrato)
  franjaHoraria   FranjaHoraria
  // Precio de referencia que calcula LA PLATAFORMA al crear el caso, según
  // franja horaria + si el intake disparó alguna bandera roja (ver
  // honorarioBaseDe() en packages/types) — es la base sobre la que cada
  // veterinario conectado aplica su margenPorcentaje en la pantalla de
  // "elegí veterinario". Nullable por el mismo motivo histórico que
  // honorarioDeclarado: nace en null hasta que CasosService.crear() lo
  // completa, un instante después.
  honorarioBase      Decimal?  @db.Decimal(10, 2)
  // Decisión de Sergio (2026-09-29): el cliente tiene que saber el costo
  // total ANTES de contratar, así que esto ya no lo declara el veterinario
  // libremente al tomar el caso — se calcula una sola vez, cuando el
  // cliente ELIGE veterinario (ver CasosService.asignar), como
  // honorarioBase × (1 + veterinario.margenPorcentaje/100), y queda
  // congelado desde ahí (no se vuelve a tocar en PATCH /casos/:id/iniciar).
  honorarioDeclarado Decimal?  @db.Decimal(10, 2)
  cargoPlataforma    Decimal   @db.Decimal(10, 2) // $3.500 diurno / $4.000 nocturno al momento del caso

  // Cierre del caso (Sección 9): determina la Sección 8 (reembolso)
  cierre          CierreCaso?

  // Verificación de identidad de esa sesión puntual (Sección 6)
  verificacionIdentidad VerificacionIdentidad?

  // Grabación (Sección 7)
  grabacionUrl    String?
  grabacionExpiraEl DateTime?

  // Sala de video de ESTE caso (Sergio, 2026-09-29) — se completa recién al
  // pasar a EN_SESION (ver CasosService.iniciarSesion / VideoService).
  // Nullable a propósito: sigue null mientras no haya un proveedor real
  // conectado (ver módulo `video`), no es un dato que falte cargar.
  salaVideoUrl    String?

  pago            Pago?
  disputaCalidad  DisputaCalidad?

  iniciadoEl      DateTime?
  finalizadoEl    DateTime?
  creadoEl        DateTime     @default(now())

  @@index([veterinarioId, estado])
}

enum EstadoCaso {
  INTAKE                  // formulario en curso
  BANDERA_ROJA_MOSTRADA   // capa 1 disparó el aviso de emergencia (no bloquea el flujo)
  ASIGNADO                // veterinario asignado, pago autorizado (hold)
  EN_SESION
  CERRADO
  CANCELADO_FALLA_PLATAFORMA // dispara reembolso, Sección 8
}

enum FranjaHoraria {
  DIURNA    // 08:30–20:00, cargo $3.500
  NOCTURNA  // 20:01–08:29, cargo $4.000
}

// ---------------------------------------------------------------------------
// Intake de dos capas (Sección 9 del contrato)
// ---------------------------------------------------------------------------

model IntakeFormulario {
  id               String   @id @default(uuid())
  caso             Caso     @relation(fields: [casoId], references: [id])
  casoId           String   @unique

  // Capa 1 — banderas rojas (cualquier true dispara el banner, no bloquea)
  dificultadRespiratoria Boolean @default(false)
  inconsciente           Boolean @default(false)
  sangradoActivo         Boolean @default(false)
  sospechaIngestaToxico  Boolean @default(false)
  convulsionEnCurso      Boolean @default(false)
  noPuedeParseCaminar    Boolean @default(false)
  distensionAbdominal    Boolean @default(false)
  traumatismoMayor       Boolean @default(false)

  // Capa 2 — contexto clínico estándar
  especie          String
  raza             String?
  edadAproximada   String?
  pesoAproximadoKg Float?
  motivoConsulta   String
  tiempoEvolucion  String?
  medicacionActual String?
  antecedentes     String?
  fotosUrls        String[] @default([])
  videoUrl         String?

  completadoEl     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Cierre de caso — checklist estructurado (Sección 9 → determina Sección 8)
// ---------------------------------------------------------------------------

model CierreCaso {
  id               String           @id @default(uuid())
  caso             Caso             @relation(fields: [casoId], references: [id])
  casoId           String           @unique
  clasificacion    ClasificacionCierre
  notas            String?
  registradoEl     DateTime         @default(now())
}

enum ClasificacionCierre {
  RESUELTO_POR_ORIENTACION   // Sección 8: honorario completo, sin reembolso
  DERIVADO_A_EMERGENCIA      // Sección 8: honorario completo, sin reembolso
  NO_COMPLETADO              // puede habilitar reembolso si la causa es falla de plataforma
}

// ---------------------------------------------------------------------------
// Verificación de identidad (Sección 6 del contrato)
// ---------------------------------------------------------------------------

model VerificacionIdentidad {
  id             String      @id @default(uuid())
  veterinario    Veterinario @relation(fields: [veterinarioId], references: [id])
  veterinarioId  String
  caso           Caso?       @relation(fields: [casoId], references: [id])
  casoId         String?     @unique

  resultado      ResultadoVerificacion @default(PENDIENTE)
  proveedor      String      @default("truora")
  proveedorRefId String?     // process_id de Truora (Identity API), para auditoría y polling
  actualizadoEl  DateTime    @updatedAt
  creadoEl       DateTime    @default(now())
}

enum ResultadoVerificacion {
  PENDIENTE     // proceso creado en Truora, esperando resultado (API es asincrónica)
  APROBADA
  RECHAZADA
  INCONSISTENTE // dispara DisputaIdentidad y posible suspensión cautelar
}

// ---------------------------------------------------------------------------
// Pago — refleja el split Mercado Pago 1:1 (documento de proveedores, Sección 3)
// ---------------------------------------------------------------------------

model Pago {
  id                    String        @id @default(uuid())
  caso                  Caso          @relation(fields: [casoId], references: [id])
  casoId                String        @unique

  medioDeCobro          MedioDeCobroCliente
  montoTotal            Decimal       @db.Decimal(10, 2) // honorario + cargo de plataforma
  montoHonorarioVet     Decimal       @db.Decimal(10, 2)
  montoCargoPlataforma  Decimal       @db.Decimal(10, 2)

  // PENDIENTE al crear la preferencia (cliente todavía no completó el
  // checkout) → AUTORIZADO cuando el webhook confirma el pago aprobado
  // (Sergio, 2026-09-29: cobro inmediato vía Checkout Pro, split automático
  // al momento del pago — NO es un hold de captura diferida, esa función
  // solo existe en la Checkout API/Orders API, no en preferencias hosteadas
  // — verificado contra la documentación oficial de Mercado Pago).
  estado                EstadoPago    @default(PENDIENTE)

  // Referencias externas para reconciliación
  mercadoPagoPreferenciaId String?
  mercadoPagoPaymentId  String?
  paypalOrderId         String?       // cuando el split es en dos pasos (PayPal Payouts), ver doc de proveedores
  paypalPayoutId        String?

  creadoEl              DateTime      @default(now())
  pagadoEl              DateTime?     // cuando el webhook confirmó el pago aprobado
  capturadoEl           DateTime?     // solo bookkeeping: el cobro ya ocurrió en pagadoEl, acá se marca que no corresponde reembolso
  reembolsadoEl         DateTime?     // cuando se ejecutó (vía API) el reembolso automático
  // Monto efectivamente devuelto al tutor vía la API de Mercado Pago. En
  // NO_COMPLETADO es (montoTotal - CARGO_NO_COMPLETADO), una única llamada
  // de reembolso parcial — no el total. Ver el comentario de
  // `montoPendienteAccionManual` para por qué no es el 100%.
  montoReembolsado      Decimal?      @db.Decimal(10, 2)

  // [Seguro, verificado contra la documentación oficial de Mercado Pago]: un
  // reembolso sobre un pago con split (marketplace_fee) se reparte de forma
  // PROPORCIONAL entre vendedor y marketplace según la proporción original
  // de cada uno en el cobro — no existe en la API un campo para pedir
  // "sacale 100% al vendedor y una porción distinta a la mía". Esto tiene
  // dos consecuencias distintas según el flujo:
  //
  // 1) NO_COMPLETADO (liquidarSegunCierre): automatizamos UN solo reembolso
  //    parcial de (montoTotal - CARGO_NO_COMPLETADO) al tutor — eso sí es
  //    seguro, porque cumple exactamente lo que el tutor ve ("te
  //    devolvemos todo menos $X") sin arriesgar de más. Lo que queda
  //    imperfecto es el reparto INTERNO de esos $X retenidos entre vet y
  //    plataforma: Mercado Pago los reparte proporcional a lo que cada uno
  //    cobró, no 100% a la plataforma como pide el contrato. Acá queda
  //    anotado cuánto le quedó de más al vet de esos $X, para
  //    descontárselo a mano en su próxima liquidación.
  //
  // 2) Disputa de calidad — "solo se reembolsa el cargo de plataforma,
  //    nunca el honorario del vet" (Sección 8, ver disputas.service.ts):
  //    acá NO se automatiza ninguna llamada a la API, ni siquiera parcial,
  //    porque cualquier monto que se pida reembolsar sale proporcional del
  //    vet también — violaría la regla de "nunca tocar el honorario del
  //    veterinario". Todo el monto queda anotado para ejecución 100% manual
  //    (coordinado directamente con el vet, fuera de la API de reembolsos).
  montoPendienteAccionManual Decimal? @db.Decimal(10, 2)
  notaAccionManual      String?
}

enum MedioDeCobroCliente {
  MERCADO_PAGO
  STRIPE
  PAYPAL
}

enum EstadoPago {
  PENDIENTE            // preferencia creada, cliente todavía no completó el pago
  AUTORIZADO           // pago aprobado por Mercado Pago, sesión aún no cerrada
  CAPTURADO            // caso resuelto por orientación o derivado — cobro completo
  REEMBOLSADO_TOTAL    // NO_COMPLETADO — reembolso 100% ejecutado vía API (ver montoPendienteAccionManual)
  REEMBOLSADO_PARCIAL  // solo el cargo de plataforma, por falla de plataforma (Sección 8) — hoy vía acción manual, ver notaAccionManual
  CANCELADO            // no llegó a capturarse
}

// ---------------------------------------------------------------------------
// Disputas — dos circuitos separados (Sección 10 del contrato)
// ---------------------------------------------------------------------------

model DisputaIdentidad {
  id                 String      @id @default(uuid())
  veterinario        Veterinario @relation(fields: [veterinarioId], references: [id])
  veterinarioId      String
  motivo             String
  estado             EstadoDisputa @default(ABIERTA)
  resolucion         String?
  // Auditoría de staff — qué admin abrió/resolvió, no una clave compartida.
  abiertaPorAdminId  String?
  resueltaPorAdminId String?
  abiertaEl          DateTime    @default(now())
  resueltaEl         DateTime?
}

model DisputaCalidad {
  id                 String      @id @default(uuid())
  caso               Caso        @relation(fields: [casoId], references: [id])
  casoId             String      @unique
  motivo             String
  // Nunca afecta el pago ya liquidado al veterinario (Sección 10) — como máximo,
  // resuelve en reembolso del cargo de plataforma, nunca del honorario.
  estado             EstadoDisputa @default(ABIERTA)
  resolucion         String?
  resueltaPorAdminId String?
  abiertaEl          DateTime    @default(now())
  resueltaEl         DateTime?
}

enum EstadoDisputa {
  ABIERTA
  EN_REVISION
  RESUELTA
}

// ---------------------------------------------------------------------------
// Calificaciones y premios (Secciones 11 y 12 del contrato)
// ---------------------------------------------------------------------------

model Calificacion {
  id             String      @id @default(uuid())
  veterinario    Veterinario @relation(fields: [veterinarioId], references: [id])
  veterinarioId  String
  casoId         String      @unique
  estrellas      Int         // 1–5
  comentario     String?
  // Botón de confirmación no punitiva (Sección 10): dato cualitativo, nunca dispara reembolso
  creadoEl       DateTime    @default(now())
}

model PuntoPremio {
  id             String      @id @default(uuid())
  veterinario    Veterinario @relation(fields: [veterinarioId], references: [id])
  veterinarioId  String
  puntos         Int
  motivo         String      // rating sostenido / antigüedad / volumen (Sección 12)
  creadoEl       DateTime    @default(now())
}
