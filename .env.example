# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/vetteletriage"

# Autenticación — JWT compartido para login de veterinarios (email+password) y
# clientes (OTP por WhatsApp). Generar con: openssl rand -base64 48
JWT_SECRET=

# Clave de administración — STOPGAP para resolver disputas hasta que exista
# un rol de staff propio con su propio login (ver admin-key.guard.ts).
ADMIN_API_KEY=

# URL pública de apps/web — a dónde redirige el callback de OAuth de Mercado Pago
WEB_APP_URL=http://localhost:3000

# URL pública de apps/api, para que el frontend (apps/web) sepa a dónde pegarle.
# NEXT_PUBLIC_* queda embebido en el bundle del browser — nunca poner acá nada
# que no deba ser visible para el cliente.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mercado Pago — Split de Pagos 1:1 (ver doc "Elección de Proveedores Técnicos")
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# OAuth (credenciales de la App de Mercado Pago, distintas del access token de arriba)
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3001/pagos/mercadopago/oauth/callback

# PayPal — cobro opcional a clientes internacionales (PayPal Payouts, no Commerce Platform)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe — cobro a clientes internacionales con tarjeta
STRIPE_SECRET_KEY=

# Truora — verificación de identidad (RENAPER + prueba de vida)
TRUORA_API_KEY=
TRUORA_FLOW_ID=

# Video — probar Twilio, Daily.co y Zoom Video SDK antes de fijar uno (ver doc de proveedores)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DAILY_API_KEY=
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=

# WhatsApp Cloud API (Meta) — mismo esquema que Martín, número dedicado nuevo
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# Almacenamiento de grabaciones de sesión
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PORT=3001
