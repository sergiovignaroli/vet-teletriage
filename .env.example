# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/vetteletriage"

# Mercado Pago — Split de Pagos 1:1 (ver doc "Elección de Proveedores Técnicos")
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal — cobro opcional a clientes internacionales (PayPal Payouts, no Commerce Platform)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe — cobro a clientes internacionales con tarjeta
STRIPE_SECRET_KEY=

# Truora — verificación de identidad (RENAPER + prueba de vida)
TRUORA_API_KEY=

# Video — probar Twilio, Daily.co y Zoom Video SDK antes de fijar uno (ver doc de proveedores)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DAILY_API_KEY=
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=

# WhatsApp Cloud API (Meta) — mismo esquema que Martín, número dedicado nuevo
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# Almacenamiento de grabaciones de sesión
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PORT=3001
